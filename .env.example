# AVA Project Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Frontend Configuration (trip-ava/.env)
# ===========================================

# API Configuration
# Use mock API for development (true/false)
VITE_USE_MOCK_API=true

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080

# D-ID API Configuration (for virtual character streaming)
VITE_DID_API_KEY=
VITE_DID_API_URL=https://api.d-id.com

# Feature Flags
VITE_ENABLE_VOICE_FEATURES=true
VITE_ENABLE_IMAGE_FEATURES=false
VITE_ENABLE_VIDEO_FEATURES=false

# ===========================================
# Backend Configuration
# ===========================================

# Server Configuration
SERVER_PORT=8080

# AWS Configuration (for voice, image, and translation features)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1

# AWS S3 Configuration (for file storage)
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# OpenAI Configuration (for LLM features)
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Azure OpenAI (alternative to OpenAI)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Spring Configuration
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# Docker Environment (for docker-compose.yml)
# ===========================================

# Test Configuration (for running tests)
TEST_MP3_FILE_PATH=./demo/AwsPollyVoiceService.mp3
TEST_IMAGE_FILE_PATH=./demo/awsrekognitioncelebrity_jinitaimei.jpeg

# ===========================================
# Docker Environment (for docker-compose.yml)
# ===========================================

# Copy the values above without VITE_ prefix
# Example:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET_NAME=your_s3_bucket_name
# OPENAI_API_KEY=your_openai_api_key
